<Project>
  <!--
    Runs this test project the way the dotnet chaos test tool does, with the runner bundled in this package:
    dotnet build -t:ChaosTest
    Optional properties: ChaosRuns, ChaosSeed, ChaosIntensity, and ChaosArgs for options passed on to dotnet test.
  -->
  <Target Name="ChaosTest">
    <PropertyGroup>
      <_ChaosCommand>dotnet "$(MSBuildThisFileDirectory)../tools/chaos/ChaosDotNet.Cli.dll" test</_ChaosCommand>
      <_ChaosCommand Condition="'$(ChaosRuns)' != ''">$(_ChaosCommand) --runs $(ChaosRuns)</_ChaosCommand>
      <_ChaosCommand Condition="'$(ChaosSeed)' != ''">$(_ChaosCommand) --seed $(ChaosSeed)</_ChaosCommand>
      <_ChaosCommand Condition="'$(ChaosIntensity)' != ''">$(_ChaosCommand) --intensity $(ChaosIntensity)</_ChaosCommand>
    </PropertyGroup>
    <Exec Command="$(_ChaosCommand) $(ChaosArgs)" WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="high" IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>
