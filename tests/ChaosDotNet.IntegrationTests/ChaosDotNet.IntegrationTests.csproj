<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Without Docker every test skips; exit code 8 means "zero tests ran". -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChaosDotNet.Sql\ChaosDotNet.Sql.csproj" />
    <ProjectReference Include="..\..\src\ChaosDotNet.SqlServer\ChaosDotNet.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\ChaosDotNet.Npgsql\ChaosDotNet.Npgsql.csproj" />
    <ProjectReference Include="..\..\src\ChaosDotNet.EntityFrameworkCore\ChaosDotNet.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\ChaosDotNet.Redis\ChaosDotNet.Redis.csproj" />
    <ProjectReference Include="..\..\src\ChaosDotNet.AzureServiceBus\ChaosDotNet.AzureServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Data.SqlClient" VersionOverride="7.1.0" />
    <PackageReference Include="Npgsql" VersionOverride="10.0.3" />
    <PackageReference Include="StackExchange.Redis" VersionOverride="3.3.1" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.ServiceBus" />
  </ItemGroup>

</Project>
